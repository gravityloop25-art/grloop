{
  "name": "gravity-loop-desktop",
  "version": "1.0.0",
  "description": "Gravity Loop Dashboard – Desktop-App",
  "author": "Gravity Loop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.gravityloop.dashboard",
    "productName": "Gravity Loop",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "app-config.json",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
